<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>User Management</title></head><body><h1>User Management</h1><form action="${pageContext.request.contextPath}/users" method="get"><input type="hidden" name="action" value="search"><label>Country: <input name="country" value="${country}"></label><label>Sort name: <select name="sort"><option value="asc" ${sort == 'asc' ? 'selected' : ''}>A-Z</option><option value="desc" ${sort == 'desc' ? 'selected' : ''}>Z-A</option></select></label><button>Search</button></form><p><a href="${pageContext.request.contextPath}/users?action=create">Add User</a></p><table border="1" cellpadding="8"><tr><th>ID</th><th>Name</th><th>Email</th><th>Country</th><th>Actions</th></tr><c:forEach var="user" items="${users}"><tr><td>${user.id}</td><td>${user.name}</td><td>${user.email}</td><td>${user.country}</td><td><a href="${pageContext.request.contextPath}/users?action=edit&id=${user.id}">Edit</a> <a href="${pageContext.request.contextPath}/users?action=delete&id=${user.id}" onclick="return confirm('Delete this user?')">Delete</a></td></tr></c:forEach></table></body></html>
